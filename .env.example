# Copy to .env and fill in. Never commit .env.
# development: auth optional, binds 127.0.0.1 by default.
# production: GitHub OAuth is mandatory; the server refuses to start otherwise.
PLMCP_ENV=development
PLMCP_HOST=127.0.0.1
PLMCP_PORT=8000
PLMCP_LOG_LEVEL=INFO

# --- Authentication (required when PLMCP_ENV=production) ---
# PLMCP_AUTH_MODE=google   # or github
# Public HTTPS URL of this server WITHOUT /mcp, e.g. the Tailscale Funnel hostname.
# PLMCP_BASE_URL=https://pi.your-tailnet.ts.net
# GitHub OAuth App (callback: <BASE_URL>/auth/callback)
# PLMCP_GITHUB_CLIENT_ID=Ov23...
# PLMCP_GITHUB_CLIENT_SECRET=...
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PLMCP_JWT_SIGNING_KEY=...
# Comma-separated GitHub logins allowed to use the tools.
# PLMCP_ALLOWED_GITHUB_LOGINS=your-github-login
# Google OAuth client (Web application, redirect URI: <BASE_URL>/auth/callback)
# PLMCP_GOOGLE_CLIENT_ID=123-abc.apps.googleusercontent.com
# PLMCP_GOOGLE_CLIENT_SECRET=...
# Comma-separated e-mails (must be verified by Google).
# PLMCP_ALLOWED_EMAILS=someone@gmail.com
# Comma-separated Google Workspace domains: every account managed by the domain (hd claim).
# PLMCP_ALLOWED_GOOGLE_DOMAINS=firm.pl

# --- Optional tuning ---
# PLMCP_RATE_LIMIT_PER_SECOND=2
# PLMCP_RATE_LIMIT_BURST=20
# PLMCP_HTTP_TIMEOUT_SECONDS=20
# PLMCP_CACHE_TTL_SECONDS=3600
# PLMCP_CACHE_MAX_DOCUMENTS=32
